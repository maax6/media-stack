# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored — never commit it.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Host identity ---------------------------------------------------------
# Owner of the created files. Linux: usually 1000/1000 (`id -u` / `id -g`).
# macOS: usually 501/20.
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- Storage ---------------------------------------------------------------
# ONE host directory shared by every service, mounted at /data.
# Downloads and the media library must live under it so hardlinks work
# (no copy, no duplicated disk usage on import).
#   $DOWNLOADS_DIR/torrents        -> Transmission download directory
#   $DOWNLOADS_DIR/media/movies    -> Radarr root folder
#   $DOWNLOADS_DIR/media/tv        -> Sonarr root folder
DOWNLOADS_DIR=/path/to/your/media

# --- VPN (gluetun) ---------------------------------------------------------
# Supported providers and their required variables:
# https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
VPN_SERVICE_PROVIDER=cyberghost
VPN_TYPE=openvpn

# OpenVPN — leave empty when using WireGuard.
# CyberGhost: generate the credentials AND the client.crt / client.key pair in
# your account dashboard, then drop both files into config/gluetun/.
OPENVPN_USER=
OPENVPN_PASSWORD=
OPENVPN_PROTOCOL=tcp

# WireGuard — leave empty when using OpenVPN.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=

# Comma-separated exit countries, e.g. France,Switzerland. Empty = any.
SERVER_COUNTRIES=France

# Ports opened on the VPN container's firewall (Transmission web UI).
FIREWALL_INPUT_PORTS=9091

# --- Transmission credentials ----------------------------------------------
# Required: the web UI is reachable by anything that can reach BIND_ADDRESS.
TRANSMISSION_USER=changeme
TRANSMISSION_PASSWORD=changeme

# --- Published ports -------------------------------------------------------
# 127.0.0.1 = reachable only from this machine. Use 0.0.0.0 ONLY behind a
# reverse proxy with TLS and authentication — these apps have no hardening
# for direct Internet exposure.
BIND_ADDRESS=127.0.0.1
TRANSMISSION_PORT=19091
SONARR_PORT=18989
RADARR_PORT=17878
PROWLARR_PORT=19696
BAZARR_PORT=16767
